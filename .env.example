# Server-only values. Copy this file to .env.local and set your connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=peppobot

# Site only: "Sign in with Google" for crew reviews (Google Cloud console → OAuth client, type Web).
# Authorized redirect URIs: https://www.peppobot.com/api/auth/google/callback and http://localhost:4888/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
